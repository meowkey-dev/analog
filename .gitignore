# Python — the conformance harness only; Analog itself has no Python in it.
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
web/dist/
*.tsbuildinfo

# Runtime data (SQLite DB + uploaded media)
data/
!data/.gitkeep

# Local config and credentials
.analog.toml
auth.json
.env
.DS_Store

# Release archives
dist/

# npm is the supported toolchain; Vite 8 will not run under a Bun shim.
web/bun.lock

# The web bundle is copied in at build time; only the placeholder is tracked.
internal/web/dist/*
!internal/web/dist/.gitkeep

# Built binaries
/bin/
